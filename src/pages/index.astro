---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Stats from '~/components/widgets/Stats.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Home',
};
---

<Layout metadata={metadata}>
  <Hero
    tagline="TRAFALGAR LOGISTICS"
    actions={[
      {
        variant: 'primary' as const,
        text: 'Get a Quote',
        href: '/contact',
      },
      { text: 'Our Services', href: '/services' },
    ]}
  >
    <Fragment slot="title">
      Logistics <span class="text-primary">Excellence</span> in Motion
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">Trusted transport and logistics partner serving critical routes across</span>
      Zimbabwe, Zambia, and the DRC since 2002.
    </Fragment>
  </Hero>

  <Note
    title="Why Trafalgar Logistics?"
    description="Specialists in high-value metals and minerals transport. 50 trucks strong. Serving Africa with safety, reliability, and innovation since 2002."
  />

  <Features
    id="services"
    tagline="Services"
    title="What We Deliver"
    subtitle="Comprehensive logistics solutions tailored for the African continent."
    columns={3}
    items={[
      {
        title: 'Containerised Freight',
        description: 'Secure container transport across Southern Africa and the DRC. Fully tracked and customs-cleared.',
        icon: 'tabler:package',
      },
      {
        title: 'Break Bulk',
        description: 'Specialised handling of oversized, heavy-lift, and non-containerised cargo with flat deck super link trailers.',
        icon: 'tabler:layout-grid',
      },
      {
        title: '24-Hour Satellite Tracking',
        description: 'Real-time GPS monitoring of every shipment. Complete visibility from departure to delivery.',
        icon: 'tabler:satellite',
      },
      {
        title: 'Transit Bonds',
        description: 'Seamless cross-border transit bond management for hassle-free movement across African borders.',
        icon: 'tabler:file-check',
      },
      {
        title: 'Insurance & Customs',
        description: 'Comprehensive cargo insurance and customs clearance services. Fully compliant for dangerous goods transport.',
        icon: 'tabler:shield-check',
      },
      {
        title: 'Trade Finance',
        description: 'Flexible trade finance solutions to support your supply chain and keep your business moving.',
        icon: 'tabler:coins',
      },
    ]}
  />

  <Stats
    tagline="Our Fleet"
    title="Moving Africa Forward"
    stats={[
      { title: 'Trucks in Fleet', amount: '50' },
      { title: 'Years in Operation', amount: '20+' },
      { title: 'Countries Served', amount: '3' },
      { title: 'Brands', amount: '3' },
    ]}
  />

  <Content
    tagline="About Us"
    title="A Legacy of Logistics Excellence"
    isReversed={false}
    callToAction={{
      text: 'Read Our Story',
      href: '/about',
      variant: 'primary' as const,
    }}
  >
    <Fragment slot="content">
      <p>Established in 2002, Trafalgar Logistics swiftly emerged as a trusted and dependable leader in the transportation industry, serving critical routes in Zimbabwe and Zambia.</p>
      <p>We specialise in the transportation of high-value metals and minerals, implementing stringent security measures and employing seasoned professionals who are experts in their field.</p>
    </Fragment>
  </Content>

  <CallToAction
    title="Ready to Move Your Cargo?"
    subtitle="Contact us today for a competitive quote. Our team is standing by."
    callToAction={{
      text: 'Get a Quote',
      href: '/contact',
      variant: 'primary' as const,
    }}
    callToAction2={{
      text: 'Call Us: (+27) 71 677 0088',
      href: 'tel:+27716770088',
    }}
  />
</Layout>
