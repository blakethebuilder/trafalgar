---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import Content from '~/components/widgets/Content.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: 'About',
};
---

<Layout metadata={metadata}>
  <Hero
    tagline="About Us"
  >
    <Fragment slot="title">
      Africa's Trusted <span class="text-primary">Logistics Partner</span>
    </Fragment>

    <Fragment slot="subtitle">
      Two decades of moving high-value cargo across borders with safety, integrity, and precision.
    </Fragment>
  </Hero>

  <Stats
    title="Trafalgar Logistics by the Numbers"
    stats={[
      { title: 'Year Founded', amount: '2002' },
      { title: 'Fleet Size', amount: '50' },
      { title: 'Truck Brands', amount: '3' },
      { title: 'Active Routes', amount: '3' },
    ]}
  />

  <Content
    tagline="Our Journey"
    title="From South Africa to the Heart of Africa"
    isDark={false}
  >
    <Fragment slot="content">
      <p>Our journey began in 2002 with a steadfast commitment to providing top-tier transport services to Zimbabwe and Zambia. We quickly earned a reputation for excellence and reliability on these critical routes.</p>
      <p>Recognising the growing need for our expertise in the DRC market — an area characterised by unique challenges and opportunities — we expanded with the same dedication to quality and customer satisfaction.</p>
      <p>Today, Trafalgar Logistics stands as a testament to our enduring dedication to excellence, unwavering commitment to cargo and environmental safety, and relentless pursuit of innovative solutions.</p>
    </Fragment>
  </Content>

  <div class="bg-gray-50 dark:bg-slate-900">
    <Content
      tagline="Our Fleet"
      title="Built for the Long Haul"
      isReversed={true}
    >
      <Fragment slot="content">
        <p>Our fleet comprises <strong>50 trucks</strong> sourced from world-renowned brands: <strong>Iveco, Scania, and FAW</strong>. We've strategically chosen these brands for durability, power, and fuel efficiency.</p>
        <p>Our flat deck super link trailers are versatile and adaptable, equipped with twist locks for secure container transport. They're outfitted with steel or wooden uprights for specialised cargo such as lengthy pipes and steel structures.</p>
        <p>We are fully registered and compliant for the transportation of dangerous goods, ensuring even the most sensitive cargo is handled with the utmost care.</p>
      </Fragment>
    </Content>
  </div>

  <Steps2
    title="What Sets Us Apart"
    subtitle="Our commitment to excellence drives everything we do."
    items={[
      {
        title: 'Specialised Expertise',
        description: 'We specialise in high-value metals and minerals transport, implementing stringent security measures.',
      },
      {
        title: 'Proven Track Record',
        description: 'Two decades of reliable service across Zimbabwe, Zambia, and the DRC with an impeccable safety record.',
      },
      {
        title: 'Modern Fleet',
        description: '50 trucks from Iveco, Scania, and FAW — equipped for containerised, break bulk, and dangerous goods transport.',
      },
    ]}
  />

  <Features2
    title="Our Leadership"
    tagline="Management Team"
    columns={2}
    items={[
      {
        title: 'Chris Groenewald',
        description: 'Operations Manager',
      },
      {
        title: 'Ryan Rossiter',
        description: 'General Manager',
      },
    ]}
  />
</Layout>
