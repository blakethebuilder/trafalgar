---
import Layout from '~/layouts/PageLayout.astro';

import Image from '~/components/common/Image.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

import truck2 from '~/assets/images/DSC_8623-2.jpg';
import truck3 from '~/assets/images/DSC_8630.jpg';
import highway from '~/assets/images/highway.jpg';

const metadata = {
  title: 'About',
};

const specs = [
  { code: 'SPEC-01', label: 'Year Founded', value: '2002' },
  { code: 'SPEC-02', label: 'Fleet Size', value: '50' },
  { code: 'SPEC-03', label: 'Truck Brands', value: '3' },
  { code: 'SPEC-04', label: 'Active Corridors', value: '3' },
];

const differentiators = [
  {
    code: '01',
    title: 'Specialised Expertise',
    description: 'High-value metals and minerals transport with stringent security measures and seasoned professionals.',
  },
  {
    code: '02',
    title: 'Proven Track Record',
    description: 'Two decades of reliable cross-border service across Zimbabwe, Zambia, and the DRC.',
  },
  {
    code: '03',
    title: 'Modern Fleet',
    description: '50 trucks from Iveco, Scania, and FAW — equipped for containerised, break bulk, and dangerous goods.',
  },
];
---

<Layout metadata={metadata}>
  <!-- ============ HERO ============ -->
  <section class="relative bg-dark overflow-hidden not-prose">
    <div class="absolute inset-0" aria-hidden="true">
      <Image
        src={highway}
        class="w-full h-full object-cover opacity-20"
        widths={[800, 1200, 1600]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        format="webp"
        width={1600}
        height={900}
        alt=""
      />
      <div class="absolute inset-0 bg-gradient-to-r from-[#121212] via-[#121212]/80 to-transparent"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 py-20 md:py-28">
      <div class="flex items-center gap-3 mb-6">
        <span class="inline-block w-8 h-[2px] bg-primary"></span>
        <span class="text-primary font-mono text-xs tracking-[0.25em] uppercase">About Us</span>
      </div>
      <h1 class="text-4xl md:text-6xl font-heading leading-[1.02] text-base-content uppercase tracking-tight max-w-3xl">
        Two Decades.<br />Three Borders.<br /><span class="text-primary">One Standard.</span>
      </h1>
      <p class="text-lg text-muted mt-6 max-w-xl leading-relaxed">
        Established 2002. Specialists in high-value metals and minerals transport across
        Southern Africa — moving cargo with safety, integrity, and precision.
      </p>
    </div>
  </section>

  <!-- ============ SPEC SHEET ============ -->
  <section class="bg-page py-16 md:py-20 not-prose">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3">
        {
          specs.map((s) => (
            <div class="bg-base-200 border border-base-300 px-5 py-5">
              <div class="font-mono text-[10px] text-primary tracking-[0.2em]">{s.code}</div>
              <div class="text-2xl md:text-3xl font-heading text-base-content mt-1">{s.value}</div>
              <div class="text-xs uppercase tracking-widest text-muted mt-1">{s.label}</div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ JOURNEY ============ -->
  <section class="bg-page pb-16 md:pb-24 not-prose">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <div class="flex items-center gap-3 mb-4">
            <span class="inline-block w-8 h-[2px] bg-primary"></span>
            <span class="text-primary font-mono text-xs tracking-[0.25em] uppercase">[02] The Journey</span>
          </div>
          <h2 class="text-3xl md:text-4xl font-heading text-base-content uppercase tracking-tight mb-6">
            From Boksburg to the Heart of Africa
          </h2>
          <div class="space-y-4 text-muted leading-relaxed">
            <p>
              Our journey began in 2002 with a steadfast commitment to top-tier transport services
              on the critical Zimbabwe and Zambia routes. We earned a reputation for excellence
              and reliability fast.
            </p>
            <p>
              Recognising the growing need for our expertise in the DRC market — a region of unique
              challenges and opportunities — we expanded with the same dedication to quality and
              customer satisfaction.
            </p>
            <p>
              Today we stand as a testament to enduring excellence: unwavering commitment to cargo
              and environmental safety, and relentless pursuit of innovative solutions.
            </p>
          </div>
        </div>
        <div class="relative">
          <div class="absolute inset-0 bg-primary/10 translate-x-4 translate-y-4" aria-hidden="true"></div>
          <Image
            src={truck3}
            class="relative border border-base-300 w-full h-[300px] md:h-[420px] object-cover"
            widths={[600, 900]}
            sizes="(max-width: 1023px) 100vw, 45vw"
            loading="lazy"
            format="webp"
            width={1024}
            height={681}
            alt="Trafalgar Logistics truck on route"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ============ FLEET ============ -->
  <section class="bg-base-200 border-y border-base-300 py-16 md:py-24 not-prose">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="grid lg:grid-cols-2 gap-10 items-center">
        <div class="order-2 lg:order-1">
          <div class="flex items-center gap-3 mb-4">
            <span class="inline-block w-8 h-[2px] bg-primary"></span>
            <span class="text-primary font-mono text-xs tracking-[0.25em] uppercase">[03] The Fleet</span>
          </div>
          <h2 class="text-3xl md:text-4xl font-heading text-base-content uppercase tracking-tight mb-6">
            Built For The Long Haul
          </h2>
          <div class="space-y-4 text-muted leading-relaxed">
            <p>
              <strong class="text-base-content">50 trucks</strong> sourced from world-renowned brands —
              <strong class="text-base-content">Iveco, Scania, and FAW</strong> — chosen for durability,
              power, and fuel efficiency.
            </p>
            <p>
              Flat deck super link trailers with twist locks for secure container transport, outfitted
              with steel or wooden uprights for pipes and steel structures.
            </p>
            <p>
              Fully registered and compliant for dangerous goods — sensitive cargo, handled with care.
            </p>
          </div>
        </div>
        <div class="order-1 lg:order-2 relative">
          <div class="absolute inset-0 bg-primary/10 -translate-x-4 -translate-y-4" aria-hidden="true"></div>
          <Image
            src={truck2}
            class="relative border border-base-300 w-full h-[260px] md:h-[380px] object-cover"
            widths={[600, 900]}
            sizes="(max-width: 1023px) 100vw, 45vw"
            loading="lazy"
            format="webp"
            width={1024}
            height={681}
            alt="Trafalgar Logistics flat deck super link trailer"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ============ DIFFERENTIATORS ============ -->
  <section class="bg-page py-16 md:py-24 not-prose">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="flex items-center gap-3 mb-4">
        <span class="inline-block w-8 h-[2px] bg-primary"></span>
        <span class="text-primary font-mono text-xs tracking-[0.25em] uppercase">[04] What Sets Us Apart</span>
      </div>
      <h2 class="text-3xl md:text-4xl font-heading text-base-content uppercase tracking-tight mb-10">
        Why Trafalgar
      </h2>
      <div class="grid md:grid-cols-3 gap-4">
        {
          differentiators.map((d) => (
            <div class="card bg-base-200 border border-base-300 rounded-none">
              <div class="card-body p-6 md:p-8">
                <div class="font-mono text-[10px] text-primary tracking-[0.2em] mb-6">[D-{d.code}]</div>
                <div class="text-xl font-heading text-base-content uppercase tracking-tight mb-3">{d.title}</div>
                <p class="text-sm text-muted">{d.description}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ LEADERSHIP ============ -->
  <section class="bg-base-200 border-y border-base-300 py-16 md:py-20 not-prose">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="flex items-center gap-3 mb-4">
        <span class="inline-block w-8 h-[2px] bg-primary"></span>
        <span class="text-primary font-mono text-xs tracking-[0.25em] uppercase">[05] Leadership</span>
      </div>
      <h2 class="text-3xl md:text-4xl font-heading text-base-content uppercase tracking-tight mb-10">
        The Team
      </h2>
      <div class="grid md:grid-cols-2 gap-4 max-w-3xl">
        <div class="bg-page border border-base-300 px-6 py-6">
          <div class="w-10 h-10 flex items-center justify-center bg-primary/15 text-primary mb-4">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-6.5 8-6.5s8 2.5 8 6.5"/></svg>
          </div>
          <div class="text-xl font-heading text-base-content uppercase tracking-tight">Chris Groenewald</div>
          <div class="text-sm text-primary mt-1">Operations Manager</div>
          <div class="text-sm text-muted mt-3">chris@trafalgarlogistics.co.za · 066 599 3572</div>
        </div>
        <div class="bg-page border border-base-300 px-6 py-6">
          <div class="w-10 h-10 flex items-center justify-center bg-primary/15 text-primary mb-4">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-6.5 8-6.5s8 2.5 8 6.5"/></svg>
          </div>
          <div class="text-xl font-heading text-base-content uppercase tracking-tight">Ryan Rossiter</div>
          <div class="text-sm text-primary mt-1">General Manager</div>
          <div class="text-sm text-muted mt-3">ryan@trafalgarlogistics.co.za · 071 677 0088</div>
        </div>
      </div>
    </div>
  </section>

  <CallToAction
    title="Work With a Team That's Done The Route"
    subtitle="Two decades. Three borders. Zero compromises."
    callToAction={{
      text: 'Get a Quote',
      href: '/contact',
      variant: 'primary' as const,
    }}
  />
</Layout>
