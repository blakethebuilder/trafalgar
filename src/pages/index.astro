---
import Layout from '~/layouts/PageLayout.astro';

import Image from '~/components/common/Image.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Stats from '~/components/widgets/Stats.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

import truck from '~/assets/images/DSC_8613-2.jpg';
import highway from '~/assets/images/highway.jpg';

const metadata = {
  title: 'Home',
};

const ticker = [
  'Containerised Freight',
  'Break Bulk',
  '24-Hour Satellite Tracking',
  'Transit Bonds',
  'Insurance',
  'Customs Clearance',
  'Trade Finance',
];
---

<Layout metadata={metadata}>
  <!-- Hero — SupplyLink diagonal split -->
  <section class="relative overflow-hidden bg-dark not-prose">
    <div class="absolute inset-0" aria-hidden="true">
      <Image
        src={highway}
        class="w-full h-full object-cover opacity-25"
        widths={[800, 1200, 1600]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        format="webp"
        width={1600}
        height={900}
        alt=""
      />
      <div class="absolute inset-0 bg-gradient-to-r from-[#121212] via-[#121212]/70 to-[#253C43]/60"></div>
    </div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6">
      <div class="grid lg:grid-cols-2 gap-12 items-center py-20 md:py-28">
        <div>
          <p class="text-primary font-bold tracking-[0.2em] uppercase text-sm mb-5">Trafalgar Logistics</p>
          <h1 class="text-5xl md:text-6xl font-heading leading-tight text-white uppercase tracking-tight">
            Logistics <span class="text-primary">Excellence</span> in Motion
          </h1>
          <p class="text-xl text-slate-300 mt-6 max-w-xl">
            Trusted transport and logistics partner serving critical routes across Zimbabwe, Zambia, and the DRC since 2002.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 mt-10">
            <a href="/contact" class="btn btn-primary btn-lg rounded-full px-8">Get a Quote</a>
            <a href="/services" class="btn btn-outline btn-lg rounded-full px-8 border-slate-600 text-white hover:border-primary hover:text-primary">Our Services</a>
          </div>
        </div>

        <div class="relative hidden lg:block">
          <div class="absolute -inset-3 bg-primary/20 blur-2xl rounded-2xl" aria-hidden="true"></div>
          <Image
            src={truck}
            class="relative rounded-xl border border-slate-700 w-full object-cover"
            widths={[600, 900, 1200]}
            sizes="(max-width: 1023px) 0px, 600px"
            loading="eager"
            fetchpriority="high"
            format="webp"
            width={1024}
            height={681}
            alt="Trafalgar Logistics truck fleet"
          />
          <div class="absolute -bottom-5 -left-5 bg-[#253C43] border border-slate-600 rounded-lg px-5 py-4 shadow-2xl">
            <div class="text-3xl font-heading text-primary">50</div>
            <div class="text-xs uppercase tracking-widest text-slate-300">Trucks in Fleet</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Brand ticker strip -->
    <div class="relative bg-[#40d24d] border-y border-black/20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 py-3 overflow-hidden whitespace-nowrap">
        <div class="inline-flex gap-8 text-black/90 text-sm font-bold uppercase tracking-wider animate-[marquee_40s_linear_infinite]">
          {[...Array(2)].map(() =>
            ticker.map((t) => (
              <span class="inline-flex items-center gap-8">
                {t} <span class="text-black/50">◆</span>
              </span>
            ))
          )}
        </div>
      </div>
    </div>
  </section>

  <style>
    @keyframes marquee {
      0% { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }
  </style>

  <Note
    title="Why Trafalgar Logistics?"
    description="Specialists in high-value metals and minerals transport. 50 trucks strong. Serving Africa with safety, reliability, and innovation since 2002."
  />

  <Features
    id="services"
    tagline="Services"
    title="What We Deliver"
    subtitle="Comprehensive logistics solutions tailored for the African continent."
    columns={3}
    items={[
      {
        title: 'Containerised Freight',
        description: 'Secure container transport across Southern Africa and the DRC. Fully tracked and customs-cleared.',
        icon: 'tabler:package',
      },
      {
        title: 'Break Bulk',
        description: 'Specialised handling of oversized, heavy-lift, and non-containerised cargo with flat deck super link trailers.',
        icon: 'tabler:layout-grid',
      },
      {
        title: '24-Hour Satellite Tracking',
        description: 'Real-time GPS monitoring of every shipment. Complete visibility from departure to delivery.',
        icon: 'tabler:satellite',
      },
      {
        title: 'Transit Bonds',
        description: 'Seamless cross-border transit bond management for hassle-free movement across African borders.',
        icon: 'tabler:file-check',
      },
      {
        title: 'Insurance & Customs',
        description: 'Comprehensive cargo insurance and customs clearance services. Fully compliant for dangerous goods transport.',
        icon: 'tabler:shield-check',
      },
      {
        title: 'Trade Finance',
        description: 'Flexible trade finance solutions to support your supply chain and keep your business moving.',
        icon: 'tabler:coins',
      },
    ]}
  />

  <Stats
    tagline="Our Fleet"
    title="Moving Africa Forward"
    stats={[
      { title: 'Trucks in Fleet', amount: '50' },
      { title: 'Years in Operation', amount: '20+' },
      { title: 'Countries Served', amount: '3' },
      { title: 'Brands', amount: '3' },
    ]}
  />

  <Content
    tagline="About Us"
    title="A Legacy of Logistics Excellence"
    isReversed={false}
    callToAction={{
      text: 'Read Our Story',
      href: '/about',
      variant: 'primary' as const,
    }}
  >
    <Fragment slot="content">
      <p>Established in 2002, Trafalgar Logistics swiftly emerged as a trusted and dependable leader in the transportation industry, serving critical routes in Zimbabwe and Zambia.</p>
      <p>We specialise in the transportation of high-value metals and minerals, implementing stringent security measures and employing seasoned professionals who are experts in their field.</p>
    </Fragment>
  </Content>

  <CallToAction
    title="Ready to Move Your Cargo?"
    subtitle="Contact us today for a competitive quote. Our team is standing by."
    callToAction={{
      text: 'Get a Quote',
      href: '/contact',
      variant: 'primary' as const,
    }}
    callToAction2={{
      text: 'Call Us: (+27) 71 677 0088',
      href: 'tel:+27716770088',
    }}
  />
</Layout>
