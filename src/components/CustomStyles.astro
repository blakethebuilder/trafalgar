---
import '@fontsource-variable/inter';

// Archivo and Archivo Black for Trafalgar Logistics brand
---

<style is:inline>
  @import url('https://fonts.googleapis.com/css2?family=Archivo+Black&family=Archivo:wght@400;500;600;700&display=swap');

  :root {
    --aw-font-sans: 'Archivo', 'Inter Variable', sans-serif;
    --aw-font-serif: 'Archivo', 'Inter Variable', serif;
    --aw-font-heading: 'Archivo Black', 'Archivo', sans-serif;

    --aw-color-primary: rgb(73 206 73);
    --aw-color-secondary: rgb(58 184 58);
    --aw-color-accent: rgb(26 32 41);

    --aw-color-text-heading: rgb(26 32 41);
    --aw-color-text-default: rgb(30 30 30);
    --aw-color-text-muted: rgb(30 30 30 / 66%);
    --aw-color-bg-page: rgb(255 255 255);

    --aw-color-bg-page-dark: rgb(26 32 41);

    ::selection {
      background-color: rgb(73 206 73 / 25%);
    }
  }

  .dark {
    --aw-font-sans: 'Archivo', 'Inter Variable', sans-serif;
    --aw-font-serif: 'Archivo', 'Inter Variable', serif;
    --aw-font-heading: 'Archivo Black', 'Archivo', sans-serif;

    --aw-color-primary: rgb(73 206 73);
    --aw-color-secondary: rgb(58 184 58);
    --aw-color-accent: rgb(26 32 41);

    --aw-color-text-heading: rgb(247 248 248);
    --aw-color-text-default: rgb(229 236 246);
    --aw-color-text-muted: rgb(229 236 246 / 66%);
    --aw-color-bg-page: rgb(26 32 41);

    ::selection {
      background-color: rgb(73 206 73 / 40%);
    }
  }
</style>
