---
import { Icon } from 'astro-icon/components';
import { SITE } from 'astrowind:config';
import { getHomePermalink } from '~/utils/permalinks';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface Links {
  title?: string;
  links: Array<Link>;
}

export interface Props {
  links: Array<Links>;
  secondaryLinks: Array<Link>;
  socialLinks: Array<Link>;
  footNote?: string;
  theme?: string;
}

const { socialLinks = [], secondaryLinks = [], links = [], footNote = '', theme = 'dark' } = Astro.props;
---

<footer class:list={[{ dark: theme === 'dark' }, 'relative border-t border-base-300 bg-base-200 not-prose']}>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-12 gap-4 gap-y-10 sm:gap-8 py-12 md:py-16">
      <div class="col-span-12 lg:col-span-5">
        <a class="inline-block font-heading font-bold text-2xl text-base-content" href={getHomePermalink()}>
          {SITE?.name}
        </a>
        <p class="text-sm text-muted mt-3 max-w-sm">
          Transport and logistics specialists serving critical routes across Zimbabwe, Zambia, and the DRC since 2002. High-value metals and minerals, moved with precision.
        </p>
        <div class="flex gap-3 mt-6">
          {
            socialLinks?.length
              ? socialLinks.map(({ ariaLabel, href, text, icon }) => (
                  <a
                    class="btn btn-sm btn-outline border-base-300 text-muted hover:border-primary hover:text-primary"
                    aria-label={ariaLabel}
                    href={href}
                  >
                    {icon && <Icon name={icon} class="w-4 h-4" />}
                    <Fragment set:html={text} />
                  </a>
                ))
              : ''
          }
        </div>
      </div>

      {
        links.map(({ title, links }) => (
          <div class="col-span-6 md:col-span-3 lg:col-span-2">
            <div class="font-medium text-base-content mb-3">{title}</div>
            {links && Array.isArray(links) && links.length > 0 && (
              <ul class="text-sm space-y-2.5">
                {links.map(({ text, href, ariaLabel }) => (
                  <li>
                    <a
                      class="text-muted hover:text-primary transition duration-150 ease-in-out"
                      href={href}
                      aria-label={ariaLabel}
                    >
                      <Fragment set:html={text} />
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))
      }

      <div class="col-span-6 md:col-span-3 lg:col-span-3">
        <div class="font-medium text-base-content mb-3">Contact</div>
        <ul class="text-sm space-y-3">
          {
            secondaryLinks.map(({ text, href, icon }) => (
              <li class="flex items-start gap-2.5 text-muted">
                {icon && <Icon name={icon} class="w-4 h-4 mt-0.5 text-primary shrink-0" />}
                {href && href !== '#' ? (
                  <a href={href} class="hover:text-primary transition duration-150 ease-in-out">
                    <Fragment set:html={text} />
                  </a>
                ) : (
                  <span><Fragment set:html={text} /></span>
                )}
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3 py-6 border-t border-base-300">
      <div class="text-sm text-muted">
        <Fragment set:html={footNote} />
      </div>
      <div class="text-sm text-muted">Built in South Africa</div>
    </div>
  </div>
</footer>
