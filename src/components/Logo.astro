  <img src="/assets/logo.png" alt="{SITE?.name}" class="h-10 w-auto" />
  <span class="self-center ml-2 rtl:ml-0 rtl:mr-2 text-xl font-heading font-bold text-gray-900 whitespace-nowrap dark:text-white">
    {SITE?.name}
  </span>
</a>
