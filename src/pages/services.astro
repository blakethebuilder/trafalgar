---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Services',
};
---

<Layout metadata={metadata}>
  <Hero
    tagline="Our Services"
  >
    <Fragment slot="title">
      Comprehensive <span class="text-primary">Logistics Solutions</span>
    </Fragment>

    <Fragment slot="subtitle">
      End-to-end services covering every link in the African supply chain.
    </Fragment>
  </Hero>

  <Features
    tagline="Core Services"
    title="What We Do"
    subtitle="From cross-border freight to trade finance — we handle it all."
    columns={3}
    items={[
      {
        title: 'Containerised Freight',
        description:
          'Secure, tracked container transport across Southern Africa and the DRC. Our flat deck super link trailers with twist locks ensure your containers arrive safely, every time.',
        icon: 'tabler:package',
      },
      {
        title: 'Break Bulk',
        description:
          'Specialised handling of oversized, heavy-lift, and non-containerised cargo. Our steel and wooden upright configurations accommodate lengthy pipes, steel structures, and irregular loads.',
        icon: 'tabler:layout-grid',
      },
      {
        title: '24-Hour Satellite Tracking',
        description:
          'Real-time GPS monitoring on every shipment. Complete visibility from departure to delivery, with proactive alerts and precise ETAs for your peace of mind.',
        icon: 'tabler:satellite',
      },
      {
        title: 'Transit Bonds',
        description:
          'Seamless cross-border transit bond management. We handle the paperwork so your cargo moves freely across Zimbabwe, Zambia, and DRC borders without delays.',
        icon: 'tabler:file-shield',
      },
      {
        title: 'Customs Clearance',
        description:
          'Expert customs clearance services navigating complex African trade regulations. Our experience minimises border delays and ensures full compliance.',
        icon: 'tabler:shield-check',
      },
      {
        title: 'Insurance',
        description:
          'Comprehensive cargo insurance cover for peace of mind. Protect your high-value metals, minerals, and goods throughout their journey.',
        icon: 'tabler:shield',
      },
      {
        title: 'Trade Finance',
        description:
          'Flexible financing solutions to support your supply chain. Keep your business moving with trade finance options tailored to the logistics industry.',
        icon: 'tabler:coins',
      },
    ]}
  />

  <Features
    tagline="Certifications"
    title="Dangerous Goods Compliant"
    subtitle="We are fully registered and compliant for the transportation of dangerous goods, ensuring even the most sensitive cargo is handled with the utmost care and adherence to safety regulations."
    columns={1}
    items={[
      {
        title: 'Dangerous Goods Transport',
        description: 'Fully registered and compliant. Our team is trained in handling hazardous materials according to ADR and local regulations.',
        icon: 'tabler:alert-triangle',
      },
    ]}
  />

  <CallToAction
    title="Need a Custom Logistics Solution?"
    subtitle="Contact us for a tailored quote. Our team will design the right solution for your cargo."
    callToAction={{
      text: 'Get a Quote',
      href: '/contact',
      variant: 'primary' as const,
    }}
    callToAction2={{
      text: 'Call: (+27) 71 677 0088',
      href: 'tel:+27716770088',
    }}
  />
</Layout>
