---
import '@fontsource-variable/inter';

// Archivo and Archivo Black for Trafalgar Logistics brand
---

<style is:inline>
  @import url('https://fonts.googleapis.com/css2?family=Archivo+Black&family=Archivo:wght@400;500;600;700;800&display=swap');

  :root {
    --aw-font-sans: 'Archivo', 'Inter Variable', sans-serif;
    --aw-font-serif: 'Archivo', 'Inter Variable', serif;
    --aw-font-heading: 'Archivo Black', 'Archivo', sans-serif;

    /* Trafalgar brand — green #40d24d on dark slate */
    --aw-color-primary: rgb(64 210 77);        /* #40d24d */
    --aw-color-secondary: rgb(74 107 117);     /* muted teal #4A6B75 */
    --aw-color-accent: rgb(64 210 77);         /* green accent */

    --aw-color-text-heading: rgb(247 248 248);
    --aw-color-text-default: rgb(229 236 246);
    --aw-color-text-muted: rgb(229 236 246 / 66%);
    --aw-color-bg-page: rgb(18 18 18);         /* near-black #121212 */
    --aw-color-bg-page-dark: rgb(37 60 67);    /* slate #253C43 */

    ::selection {
      background-color: rgb(64 210 77 / 40%);
    }
  }

  .dark {
    --aw-font-sans: 'Archivo', 'Inter Variable', sans-serif;
    --aw-font-serif: 'Archivo', 'Inter Variable', serif;
    --aw-font-heading: 'Archivo Black', 'Archivo', sans-serif;

    --aw-color-primary: rgb(64 210 77);
    --aw-color-secondary: rgb(74 107 117);
    --aw-color-accent: rgb(64 210 77);

    --aw-color-text-heading: rgb(247 248 248);
    --aw-color-text-default: rgb(229 236 246);
    --aw-color-text-muted: rgb(229 236 246 / 66%);
    --aw-color-bg-page: rgb(18 18 18);
    --aw-color-bg-page-dark: rgb(37 60 67);

    ::selection {
      background-color: rgb(64 210 77 / 40%);
    }
  }
</style>
