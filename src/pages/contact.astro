---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ContactUs from '~/components/widgets/Contact.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: 'Contact',
};
---

<Layout metadata={metadata}>
  <HeroText tagline="Contact" title="Get in Touch" />

  <ContactUs
    id="form"
    title="Request a Quote"
    subtitle="Tell us about your cargo and we'll get back to you within 24 hours with a competitive quote."
    inputs={[
      {
        type: 'text',
        name: 'name',
        label: 'Your Name',
      },
      {
        type: 'text',
        name: 'company',
        label: 'Company Name',
      },
      {
        type: 'email',
        name: 'email',
        label: 'Email Address',
      },
      {
        type: 'tel',
        name: 'phone',
        label: 'Phone Number',
      },
    ]}
    textarea={{
      label: 'Cargo Details',
    }}
    disclaimer={{
      label:
        'By submitting this form, you agree to be contacted regarding your logistics requirements.',
    }}
    description="Our team typically responds within 24 business hours."
  />

  <Features2
    title="Contact Information"
    tagline="Reach Us"
    columns={2}
    items={[
      {
        title: 'Address',
        description: '103 Springbok Road, Bartlett AH, Boksburg',
        icon: 'tabler:map-pin',
      },
      {
        title: 'Operations Manager',
        description: 'Chris Groenewald — chris@trafalgarlogistics.co.za',
        icon: 'tabler:user',
      },
      {
        title: 'General Manager',
        description: 'Ryan Rossiter — ryan@trafalgarlogistics.co.za',
        icon: 'tabler:user',
      },
      {
        title: 'Phone',
        description: '(+)27 71 677 0088',
        icon: 'tabler:phone',
      },
      {
        title: 'Email',
        description: 'chris@trafalgarlogistics.co.za',
        icon: 'tabler:mail',
      },
      {
        title: 'Email',
        description: 'ryan@trafalgarlogistics.co.za',
        icon: 'tabler:mail',
      },
    ]}
  />
</Layout>
