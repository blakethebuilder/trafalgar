---
import type { Stats as Props } from '~/types';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import { Icon } from 'astro-icon/components';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline,
  stats = [],

  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-6xl mx-auto ${classes?.container ?? ''}`} bg={bg}>
  <Headline title={title} subtitle={subtitle} tagline={tagline} />
  <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
    {
      stats &&
        stats.map(({ amount, title, icon }) => (
          <div class="stat bg-base-200 border border-base-300 rounded-xl shadow-sm text-center intersect-once motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade intersect-quarter">
            {icon && (
              <div class="flex items-center justify-center mx-auto mb-2 text-primary">
                <Icon name={icon} class="w-8 h-8" />
              </div>
            )}
            {amount && (
              <div class="stat-value font-heading text-primary text-4xl lg:text-5xl">
                {amount}
              </div>
            )}
            {title && (
              <div class="stat-desc text-sm font-medium uppercase tracking-widest text-slate-400">
                {title}
              </div>
            )}
          </div>
        ))
    }
  </div>
</WidgetWrapper>
